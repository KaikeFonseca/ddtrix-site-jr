# Copie para .env.local e preencha. Nunca coloque segredos no repositório.

# Banco Postgres (local, Supabase ou outro). Exemplo local:
DATABASE_URL=postgres://ddtrix:ddtrix@localhost:5432/ddtrix

# Login único da empresa (seção 3). Gere o hash com: npm run senha -- "senha forte"
EMPRESA_USUARIO=ddtrix
EMPRESA_SENHA_HASH=

# Segredo da sessão: 64 caracteres aleatórios. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
